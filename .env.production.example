# 复制为 .env.production 后填写。所有 VITE_ 变量都会进入前端产物，禁止放密码或密钥。
# 填写完整正式地址，不要带末尾斜杠。
VITE_SITE_URL=https://www.example.com
VITE_PUBLIC_BASE=/
VITE_OPERATOR_NAME=请填写备案主体全称
VITE_CONTACT_EMAIL=jjunzhe@zju.edu.cn
VITE_ICP_NUMBER=请填写获批后的ICP备案号

# 公安备案通常在网站开通后办理，完成前可以留空。
VITE_PUBLIC_SECURITY_NUMBER=
VITE_PUBLIC_SECURITY_URL=
